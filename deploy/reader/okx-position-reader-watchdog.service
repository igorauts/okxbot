[Unit]
Description=Bounded GET-free watchdog of OKX Shared Position Reader
After=okx-position-reader.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/python3 -u /opt/okx-grid-live/okx_position_reader_watchdog.py --loop
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
UMask=0077

[Install]
WantedBy=multi-user.target
