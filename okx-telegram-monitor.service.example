[Unit]
Description=OKX Telegram status and safety alerts
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Environment=PYTHONUNBUFFERED=1
Environment=OKX_TELEGRAM_CONFIG=/etc/okxbot/telegram.env
ExecStart=/usr/bin/python3 -u /root/okx/okx_telegram_monitor.py
Restart=always
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
