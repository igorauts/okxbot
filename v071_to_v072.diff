+def plan_buy_buffer_cleanup(active,desired,fresh_bid,max_cancels):
+    """Choose ONLY old, non-partial BUYs well away from a FRESH BID.
+
+    The edge closest to the market is the most likely next fill. A falling
+    BID must never make that BUY the first candidate just because it fell out
+    of `desired`. If fewer distant candidates exist than available slots,
+    keep the protected BUY and let the 30-order buffer fill; do not sacrifice
+    an imminent fill to achieve a cosmetic 25/25 status.
+
+    This function performs NO I/O and NEVER overrides the exchange/position
+    reconciliation gates. Caller obtains the freshest quote immediately before
+    each cancel and must repeat validation if the quote moves.
+    """
+    if fresh_bid is None or D(fresh_bid)<=0:
+        raise ExchangeUnresolved('Missing fresh BID for BUY buffer cleanup')
+    if max_cancels<=0:return [],[]
+    protected=[]
+    safe=[]
+    guard=STEP*BUY_CANCEL_PROTECT_STEPS
+    for c in active:
+        if c.get('state')!='BUY_LIVE':continue
+        px=D(c['buyPx'])
+        if px in desired:continue
+        distance=abs(px-D(fresh_bid))
+        if distance<=guard:
+            protected.append(c)
+        else:
+            safe.append(c)
+    # Farthest from the actual market first. On upward shifts this removes
+    # bottom stale BUYs; on downward shifts it never chooses the upper near-BID
+    # BUY when a more distant stale order can be removed instead.
+    safe.sort(key=lambda c:(abs(D(c['buyPx'])-D(fresh_bid)), -D(c['buyPx'])),reverse=True)
+    return safe[:max_cancels], protected
+
