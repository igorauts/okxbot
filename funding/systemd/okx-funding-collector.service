[Unit]
Description=OKX account funding statistics (GET only)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/okx-funding/paths.conf
ExecStart=/usr/bin/python3 -B -E -s /opt/okx-funding/okx_funding_collector.py --base ${FUNDING_BASE} --registry ${FUNDING_REGISTRY} --systemd-dir ${FUNDING_SYSTEMD_DIR} --data-dir /srv/okx-funding --mode update
UMask=0077
Nice=19
IOSchedulingClass=idle
CPUWeight=1
IOWeight=1
MemoryMax=150M
TimeoutStartSec=30min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/okx-funding
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
